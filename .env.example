# Google service account (see README.md "Google Cloud setup")
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the full private key from the service account JSON key file.
# Keep the \n sequences literal (do not replace them with real newlines) —
# the app converts them back at runtime.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExampleKeyContentsGoHere\n-----END PRIVATE KEY-----\n"

# Spreadsheet IDs — the long id in the sheet's URL between /d/ and /edit
# Master Ref: https://docs.google.com/spreadsheets/d/1SkQi4P09Kxtmr7U4VqRuvIdDhOVQafjcxyvd1okBS_s/edit
MASTER_SHEET_ID=1SkQi4P09Kxtmr7U4VqRuvIdDhOVQafjcxyvd1okBS_s
# Record File: https://docs.google.com/spreadsheets/d/11hfl7TyAfrz9wgn4HrJeeK9FxbgcrhfihHOuMgDdVsI/edit
RECORD_SHEET_ID=11hfl7TyAfrz9wgn4HrJeeK9FxbgcrhfihHOuMgDdVsI

# Sheet tab (bottom-tab) names — change these if you named your tabs differently
MASTER_TAB=BinMaster
RECORD_TAB=CountRecord
